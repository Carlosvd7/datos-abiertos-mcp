# Copia este fichero a .env y rellena tu clave. .env está en .gitignore: nunca se sube a git.
ANTHROPIC_API_KEY=

# Opcional: modelo y esfuerzo del agente
# Modelo: claude-haiku-5-5 (por defecto, el más barato), claude-sonnet-5-5 o claude-opus-5-5
# CLAUDE_MODELO=claude-haiku-5-5
# CLAUDE_ESFUERZO=medium

# Opcional (demo web): límites para proteger el saldo
# DEMO_PREGUNTAS_POR_DIA_IP=1        # preguntas propias por visitante y día (las de ejemplo van en caché)
# DEMO_PREGUNTAS_POR_HORA_IP=1
# DEMO_PREGUNTAS_POR_DIA_TOTAL=50
# DEMO_PRESUPUESTO_DIA_USD=0.05     # gasto máximo diario; al superarlo la demo se pausa hasta mañana
# DEMO_MAX_PASOS=6
# DEMO_MAX_TOKENS=4000
# DEMO_CONFIAR_PROXY=1              # usar X-Forwarded-For (solo detrás de un proxy de confianza)
